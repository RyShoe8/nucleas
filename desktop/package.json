{
  "name": "nucleas-desktop",
  "productName": "Nucleas",
  "version": "0.1.0",
  "private": true,
  "description": "Your company, at home on your desktop.",
  "author": "Nucleas",
  "main": "main.cjs",
  "scripts": {
    "prepare": "node scripts/catalog.cjs",
    "start": "node scripts/catalog.cjs && electron .",
    "test": "node --test policy.test.cjs",
    "pack": "node scripts/catalog.cjs && electron-builder --win --dir",
    "dist": "node scripts/catalog.cjs && electron-builder --win nsis --publish never && node scripts/verify-release.cjs"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "app.nucleas.desktop",
    "productName": "Nucleas",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "auth.cjs",
      "preload.cjs",
      "policy.cjs",
      "capture.cjs",
      "capture-preload.cjs",
      "renderer/**"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "renderer/icon.png",
      "artifactName": "Nucleas-Setup-${version}.${ext}",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://nucleas.app/desktop/releases/windows/"
      }
    ]
  }
}
