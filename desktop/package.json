{
  "name": "nucleas-desktop",
  "productName": "Nucleas",
  "version": "0.1.0",
  "private": true,
  "description": "Your company, at home on your desktop.",
  "author": "Nucleas",
  "main": "main.cjs",
  "scripts": {
    "prepare": "node scripts/catalog.cjs && node scripts/native.cjs",
    "start": "node scripts/catalog.cjs && node scripts/native.cjs && electron .",
    "test": "node --test auth.test.cjs policy.test.cjs startup-update.test.cjs taskbar-state.test.cjs taskbar.test.cjs attention.test.cjs taskbar-layout.test.cjs taskbar-compat.test.cjs shortcut-icons.test.cjs window-behavior.test.cjs",
    "test:native": "node scripts/native-test.cjs",
    "pack": "node scripts/catalog.cjs && node scripts/native.cjs && electron-builder --win --dir",
    "dist": "node scripts/catalog.cjs && node scripts/native.cjs && electron-builder --win nsis --publish never && node scripts/verify-release.cjs"
  },
  "dependencies": {
    "deskband11lib": "1.5.1",
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "app.nucleas.desktop",
    "productName": "Nucleas",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "auth.cjs",
      "auth-runtime.cjs",
      "preload.cjs",
      "policy.cjs",
      "capture.cjs",
      "capture-preload.cjs",
      "startup-update.cjs",
      "taskbar.cjs",
      "taskbar-state.cjs",
      "taskbar-preload.cjs",
      "attention.cjs",
      "attention-preload.cjs",
      "window-lifecycle.cjs",
      "licenses/**",
      "renderer/**",
      "taskbar-compat.cjs",
      "taskbar-layout.cjs",
      "shortcut-icons.cjs"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/deskband11lib/bin/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "renderer/icon.ico",
      "artifactName": "Nucleas-Setup-${version}.${ext}",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "renderer/icon.ico",
      "uninstallerIcon": "renderer/icon.ico"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://nucleas.app/desktop/releases/windows/"
      }
    ],
    "extraResources": [
      {
        "from": "native/bin/TaskbarLayout.exe",
        "to": "native/TaskbarLayout.exe"
      },
      {
        "from": "renderer/icon.ico",
        "to": "assets/nucleas-v2.ico"
      }
    ]
  }
}
